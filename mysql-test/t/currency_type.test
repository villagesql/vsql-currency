# The CURRENCY type stores an ISO 4217 code in a single byte and reads it
# back as the canonical three-letter code. These tests cover storing and
# retrieving values, case-insensitive input, and NULL handling. Rejection of
# invalid codes is covered by currency_invalid_code.

INSTALL EXTENSION vsql_currency;

CREATE DATABASE currency_db;
USE currency_db;

# A CURRENCY column accepts a three-letter code and returns it unchanged.
CREATE TABLE wallet (id INT PRIMARY KEY AUTO_INCREMENT, c vsql_currency.currency);
INSERT INTO wallet (c) VALUES ('USD');
SELECT c FROM wallet;

# Input is case-insensitive: lowercase and mixed-case codes are normalized to
# the uppercase canonical form on the way in.
INSERT INTO wallet (c) VALUES ('eur'), ('jPy');
SELECT c FROM wallet ORDER BY id;

# A nullable column stores NULL when no value is supplied.
INSERT INTO wallet (c) VALUES (NULL);
SELECT id, c FROM wallet WHERE c IS NULL;

DROP DATABASE currency_db;
UNINSTALL EXTENSION vsql_currency;

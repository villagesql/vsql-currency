# Helper functions describe the set of supported currencies: a total count, a
# membership test, and a prefix-based listing that returns a JSON array.

INSTALL EXTENSION vsql_currency;

CREATE DATABASE currency_db;
USE currency_db;

# currency_count() reports how many ISO 4217 codes are supported.
SELECT vsql_currency.currency_count() AS supported_count;

# is_currency() reports whether a code is supported. The check is
# case-insensitive and returns NULL for a NULL input.
SELECT
  vsql_currency.is_currency('USD')  AS known_upper,
  vsql_currency.is_currency('usd')  AS known_lower,
  vsql_currency.is_currency('XYZ')  AS unknown,
  vsql_currency.is_currency(NULL)   AS null_input;

# supported_currencies(prefix) returns the codes beginning with the prefix as
# a JSON array, in alphabetical order. The prefix is case-insensitive.
SELECT vsql_currency.supported_currencies('U') AS codes_u;
SELECT vsql_currency.supported_currencies('gb') AS codes_gb;

# Converting the JSON result to utf8mb4 before handing it to JSON_TABLE is
# still accepted, and is what the documented examples do because VillageSQL
# 0.0.6 and earlier require it.
SELECT code
FROM JSON_TABLE(
  CONVERT(vsql_currency.supported_currencies('U') USING utf8mb4),
  '$[*]' COLUMNS (code CHAR(3) PATH '$')
) AS j
WHERE code = 'USD';

# From VillageSQL 0.0.7 the result carries utf8mb4, so JSON_TABLE reads it
# without the conversion. On 0.0.6 and earlier this raised ER_INVALID_JSON_CHARSET.
SELECT * FROM JSON_TABLE(
  vsql_currency.supported_currencies('U'),
  '$[*]' COLUMNS (code CHAR(3) PATH '$')
) AS j;

# An empty prefix returns the full list. The result exceeds the 256-byte
# default buffer; the function's prerun sizes the buffer to fit, so the entire
# list of codes comes back intact (not truncated).
SELECT vsql_currency.supported_currencies('') AS every_supported_code;

DROP DATABASE currency_db;
UNINSTALL EXTENSION vsql_currency;
